# =============================================================================
# API do construtor de formulários: variáveis de ambiente
# Valores abaixo servem ao ambiente Docker local (compose.yaml).
# Em produção: APP_ENV=production, APP_DEBUG=false, HTTPS e segredos próprios.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
APP_NAME="Formulários"
APP_ENV=local
# Gerar com: php artisan key:generate
APP_KEY=
APP_DEBUG=true
# URL pública desta API.
APP_URL=http://localhost:8000
# URL da SPA (/web): links de email e origem padrão do CORS.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

# IPs/CIDRs dos proxies reversos confiáveis, separados por vírgula
# (ex.: o nginx do servidor). Vazio = nenhum proxy confiável.
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

# Chave secreta do hash de IP (LGPD: IP nunca é guardado puro).
# Gerar com: php -r "echo bin2hex(random_bytes(32));"  Nunca trocar depois de em uso.
IP_HASH_SALT=

# --- Responsável por esta instalação (Termos de Uso e Política de Privacidade)
# Quem instala e opera o sistema responde pelos dados coletados (LGPD).
# Os valores aparecem nos textos servidos em /api/v1/legal/{terms|privacy}.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
# Canal para pedidos de titulares de dados. Padrão: LEGAL_CONTACT_EMAIL.
LEGAL_PRIVACY_EMAIL=
# Comarca do foro, ex.: "São Paulo/SP".
LEGAL_JURISDICTION=
LEGAL_HOSTING_PROVIDER=
LEGAL_EMAIL_PROVIDER=

# --- Logs --------------------------------------------------------------------
# Nunca logar respostas, tokens ou conteúdo de arquivos (AGENTS.md §6).
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Banco (MariaDB/MySQL) ---------------------------------------------------
# `mariadb` ou `mysql`, conforme o servidor da hospedagem (ver hPanel).
DB_CONNECTION=mariadb
DB_HOST=database
DB_PORT=3306
DB_DATABASE=formularios
DB_USERNAME=formularios
DB_PASSWORD=secret
# Usado só pelo container local (compose.yaml).
DB_ROOT_PASSWORD=root-secret

# --- Fila e cache (no banco; decisão D16) ------------------------------------
# Com Redis disponível (VPS), basta trocar para `redis` aqui e em SESSION_DRIVER.
CACHE_STORE=database
QUEUE_CONNECTION=database
# Segundos até um job "travado" voltar para a fila. Maior que a duração do job.
DB_QUEUE_RETRY_AFTER=210
DB_LONG_QUEUE_RETRY_AFTER=660
# Conexão dos Jobs longos (exportações).
QUEUE_LONG_CONNECTION=database-long

# --- Sessão e Sanctum (modo SPA) ---------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Local: null. Produção: domínio pai compartilhado por SPA e API (ex.: .exemplo.com).
SESSION_DOMAIN=null
# Produção: true (cookies só via HTTPS). Padrão: true quando APP_ENV=production.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Domínios (com porta) da SPA que recebem sessão por cookie. Produção: app.exemplo.com
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# Origens liberadas no CORS, separadas por vírgula. Padrão: FRONTEND_URL.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Arquivos ----------------------------------------------------------------
FILESYSTEM_DISK=local
# Disco dos anexos de respostas. Sempre privado (`s3` disponível para storage S3-compatível).
MEDIA_DISK=local
# Soma máxima de arquivos por envio (MB). Deve caber no post_max_size/upload_max_filesize do PHP.
SUBMISSION_MAX_TOTAL_UPLOAD_MB=25
# Validade dos links de download enviados por email ao dono (dias).
ATTACHMENT_LINK_TTL_DAYS=7
# Imagens de capa/logo dos formulários (servidas publicamente pela rota /api/v1/assets/{id}).
FORM_ASSET_DISK=local
# Exportações CSV: disco privado e horas até o arquivo ser apagado.
EXPORT_DISK=local
EXPORT_TTL_HOURS=24

# --- Email (SMTP de qualquer provedor; D29) ----------------------------------
# Local: Mailpit (interface em http://localhost:8025), valores abaixo.
# Produção, ex. Brevo (grátis até 300/dia): MAIL_HOST=smtp-relay.brevo.com,
# MAIL_PORT=587, MAIL_SCHEME=null (STARTTLS automático), MAIL_USERNAME e
# MAIL_PASSWORD = login e chave SMTP do Brevo. Configure SPF, DKIM e DMARC do
# domínio de envio no provedor (AGENTS.md §6).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@example.com"
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_CONNECTION=log
