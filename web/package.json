    "gsap": "^3.15.0",
    "motion-v": "^2.8.0",
    "pinia": "^4.0.3",
    "reka-ui": "^2.11.0",
    "valibot": "^1.5.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.147",
    "@iconify/utils": "^3.1.7",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
