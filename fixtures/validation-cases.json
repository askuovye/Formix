{
  "$comment": "Contrato do motor de validação, consumido pelo Pest (api) e pelo Vitest (web). Formato documentado em fixtures/README.md. Nenhum dado real: CPFs/CNPJs são exemplos públicos de documentação.",
  "normalization": [
    { "note": "apara e junta espaços", "input": "  Maria   Souza  ", "multiline": false, "output": "Maria Souza" },
    { "note": "tab vira espaço", "input": "Maria\tSouza", "multiline": false, "output": "Maria Souza" },
    { "note": "uma linha: quebra vira espaço", "input": "linha 1\nlinha 2", "multiline": false, "output": "linha 1 linha 2" },
    { "note": "várias linhas: CRLF vira LF", "input": "linha 1\r\nlinha 2", "multiline": true, "output": "linha 1\nlinha 2" },
    { "note": "várias linhas: no máximo uma linha em branco", "input": "a\n\n\n\nb", "multiline": true, "output": "a\n\nb" },
    { "note": "várias linhas: apara cada linha", "input": "  a  \n   b   c  ", "multiline": true, "output": "a\nb c" },
    { "note": "remove zero-width space", "input": "a​a​a", "multiline": false, "output": "aaa" },
    { "note": "remove soft hyphen e BOM", "input": "﻿­teste", "multiline": false, "output": "teste" },
    { "note": "NFC: e + acento combinante vira é", "input": "café", "multiline": false, "output": "café" },
    { "note": "remove caracteres de controle", "input": "ok\u0007\u001b", "multiline": false, "output": "ok" },
    { "note": "só espaços vira vazio", "input": "   \n\t ", "multiline": false, "output": "" }
  ],
  "rules": {
    "min_length": [
      { "params": { "value": 5 }, "value": "Maria", "valid": true },
      { "params": { "value": 5 }, "value": "ações", "valid": true, "note": "conta caracteres, não bytes" },
      { "params": { "value": 5 }, "value": "Ana", "valid": false },
      { "params": { "value": 5 }, "value": "ação", "valid": false },
      { "params": { "value": 5 }, "value": "  Ana  ", "valid": false, "note": "espaços das pontas não contam" }
    ],
    "max_length": [
      { "params": { "value": 5 }, "value": "ação", "valid": true },
      { "params": { "value": 5 }, "value": "Maria", "valid": true },
      { "params": { "value": 5 }, "value": "Mariana", "valid": false }
    ],
    "min_words": [
      { "params": { "value": 3 }, "value": "três palavras aqui", "valid": true },
      { "params": { "value": 3 }, "value": "um\ndois\ntrês", "multiline": true, "valid": true },
      { "params": { "value": 3 }, "value": "R$ 50 reais", "valid": true },
      { "params": { "value": 3 }, "value": "uma palavra", "valid": false },
      { "params": { "value": 3 }, "value": "bom - ok", "valid": false, "note": "pontuação solta não é palavra" },
      { "params": { "value": 3 }, "value": "... ... ...", "valid": false }
    ],
    "min_distinct_chars": [
      { "params": { "value": 3 }, "value": "abc", "valid": true },
      { "params": { "value": 3 }, "value": "Maria", "valid": true },
      { "params": { "value": 3 }, "value": "ababab", "valid": false },
      { "params": { "value": 3 }, "value": "aaa", "valid": false },
      { "params": { "value": 3 }, "value": "AaÁá", "valid": false, "note": "maiúsculas e acentos contam como o mesmo" },
      { "params": { "value": 3 }, "value": "a a a b", "valid": false, "note": "espaços não contam" }
    ],
    "no_repeated_chars": [
      { "params": { "threshold": 0.8 }, "value": "Maria Souza", "valid": true },
      { "params": { "threshold": 0.8 }, "value": "Ana", "valid": true },
      { "params": { "threshold": 0.8 }, "value": "Ok", "valid": true, "note": "menos de 3 caracteres não é julgado" },
      { "params": { "threshold": 0.8 }, "value": "aaab c", "valid": true },
      { "params": { "threshold": 0.8 }, "value": "aaaaa", "valid": false },
      { "params": { "threshold": 0.8 }, "value": "0000000", "valid": false },
      { "params": { "threshold": 0.8 }, "value": ".....", "valid": false },
      { "params": { "threshold": 0.8 }, "value": "kkkkkkkkk", "valid": false },
      { "params": { "threshold": 0.8 }, "value": "AAAAAá", "valid": false, "note": "forma dobrada: todos viram a" },
      { "params": { "threshold": 0.8 }, "value": "aaaa b", "valid": false, "note": "4 de 5 = 0.8, no limite rejeita" },
      { "params": { "threshold": 0.8 }, "value": "a a a a a", "valid": false, "note": "espaços não contam" },
      { "params": { "threshold": 0.6 }, "value": "banana", "valid": true },
      { "params": { "threshold": 0.6 }, "value": "aaab", "valid": false }
    ],
    "no_sequences": [
      { "params": {}, "value": "Maria", "valid": true },
      { "params": {}, "value": "123", "valid": true, "note": "menor que o mínimo de 4" },
      { "params": {}, "value": "Rua Abc, 1234", "valid": true, "note": "só a resposta inteira é julgada" },
      { "params": {}, "value": "1357", "valid": true },
      { "params": {}, "value": "4321 casa", "valid": true },
      { "params": {}, "value": "lala", "valid": true, "note": "bloco repetido só 2 vezes" },
      { "params": {}, "value": "12345", "valid": false },
      { "params": {}, "value": "abcdef", "valid": false },
      { "params": {}, "value": "ABCD", "valid": false },
      { "params": {}, "value": "9876", "valid": false },
      { "params": {}, "value": "zyxw", "valid": false },
      { "params": {}, "value": "1 2 3 4 5", "valid": false, "note": "separadores são ignorados" },
      { "params": {}, "value": "123.456", "valid": false },
      { "params": {}, "value": "qwerty", "valid": false },
      { "params": {}, "value": "asdfgh", "valid": false },
      { "params": {}, "value": "lkjh", "valid": false, "note": "fileira do teclado ao contrário" },
      { "params": {}, "value": "7890", "valid": false, "note": "fileira de números do teclado" },
      { "params": {}, "value": "121212", "valid": false },
      { "params": {}, "value": "hahaha", "valid": false },
      { "params": {}, "value": "abcabcabc", "valid": false },
      { "params": { "value": 6 }, "value": "12345", "valid": true },
      { "params": { "value": 6 }, "value": "123456", "valid": false }
    ],
    "no_only_symbols": [
      { "params": {}, "value": "a", "valid": true },
      { "params": {}, "value": "1", "valid": true },
      { "params": {}, "value": "ok!", "valid": true },
      { "params": {}, "value": "Ação", "valid": true },
      { "params": {}, "value": "...", "valid": false },
      { "params": {}, "value": "!!!", "valid": false },
      { "params": {}, "value": "-", "valid": false },
      { "params": {}, "value": "?! ?!", "valid": false },
      { "params": {}, "value": "@#$%", "valid": false }
    ],
    "blocklist": [
      { "params": { "values": ["teste", "n/a", "..."] }, "value": "testes", "valid": true },
      { "params": { "values": ["teste", "n/a", "..."] }, "value": "Contestei a cobrança", "valid": true, "note": "nunca compara como substring" },
      { "params": { "values": ["teste", "n/a", "..."] }, "value": "nada", "valid": true },
      { "params": { "values": ["teste", "n/a", "..."] }, "value": "teste", "valid": false },
      { "params": { "values": ["teste", "n/a", "..."] }, "value": "TESTE", "valid": false },
      { "params": { "values": ["teste", "n/a", "..."] }, "value": "Teste.", "valid": false, "note": "pontuação ignorada quando o item tem letras" },
      { "params": { "values": ["teste", "n/a", "..."] }, "value": "tésté", "valid": false, "note": "acentos ignorados" },
      { "params": { "values": ["teste", "n/a", "..."] }, "value": "N/A", "valid": false },
      { "params": { "values": ["teste", "n/a", "..."] }, "value": "na", "valid": false, "note": "\"n/a\" sem pontuação" },
      { "params": { "values": ["teste", "n/a", "..."] }, "value": "...", "valid": false, "note": "item só de símbolos compara o texto inteiro" },
      { "params": { "values": ["teste", "n/a", "..."] }, "value": "!!!", "valid": true }
    ],
    "cpf": [
      { "params": {}, "value": "123.456.789-09", "valid": true },
      { "params": {}, "value": "11144477735", "valid": true },
      { "params": {}, "value": "111 444 777 35", "valid": true },
      { "params": {}, "value": "123.456.789-00", "valid": false, "note": "dígito verificador errado" },
      { "params": {}, "value": "111.111.111-11", "valid": false, "note": "dígitos todos iguais" },
      { "params": {}, "value": "1234567890", "valid": false, "note": "10 dígitos" },
      { "params": {}, "value": "CPF 123.456.789-09", "valid": false, "note": "letras não são aceitas" },
      { "params": {}, "value": "123.456.789/09", "valid": false, "note": "barra não é separador de CPF" }
    ],
    "cnpj": [
      { "params": {}, "value": "11.222.333/0001-81", "valid": true },
      { "params": {}, "value": "11222333000181", "valid": true },
      { "params": {}, "value": "12.ABC.345/01DE-35", "valid": true, "note": "CNPJ alfanumérico (exemplo da Receita)" },
      { "params": {}, "value": "12.abc.345/01de-35", "valid": true, "note": "letras minúsculas aceitas" },
      { "params": {}, "value": "11.222.333/0001-80", "valid": false },
      { "params": {}, "value": "00.000.000/0000-00", "valid": false },
      { "params": {}, "value": "11.222.333/0001-8", "valid": false },
      { "params": {}, "value": "11.222.333/0001-81!", "valid": false }
    ],
    "phone_br": [
      { "params": {}, "value": "(11) 98765-4321", "valid": true },
      { "params": {}, "value": "11987654321", "valid": true },
      { "params": {}, "value": "+55 11 98765-4321", "valid": true },
      { "params": {}, "value": "(21) 3456-7890", "valid": true },
      { "params": {}, "value": "2134567890", "valid": true },
      { "params": {}, "value": "(11) 88765-4321", "valid": false, "note": "celular de 11 dígitos começa com 9" },
      { "params": {}, "value": "(01) 3456-7890", "valid": false, "note": "DDD não começa com 0" },
      { "params": {}, "value": "3456-7890", "valid": false, "note": "sem DDD" },
      { "params": {}, "value": "(11) 11111-1111", "valid": false },
      { "params": {}, "value": "11 98765-4321 ramal 2", "valid": false },
      { "params": {}, "value": "11 987654-32100", "valid": false }
    ],
    "cep": [
      { "params": {}, "value": "01310-100", "valid": true },
      { "params": {}, "value": "01310100", "valid": true },
      { "params": {}, "value": "01.310-100", "valid": true },
      { "params": {}, "value": "00000-000", "valid": false },
      { "params": {}, "value": "0131010", "valid": false },
      { "params": {}, "value": "01310-1000", "valid": false },
      { "params": {}, "value": "abcde-fgh", "valid": false }
    ]
  },
  "fields": [
    { "note": "texto obrigatório só com espaços", "field": { "type": "short_text", "required": true }, "value": "   ", "valid": false },
    { "note": "texto obrigatório ausente", "field": { "type": "short_text", "required": true }, "value": null, "valid": false },
    { "note": "texto opcional ausente", "field": { "type": "short_text", "required": false }, "value": null, "valid": true, "normalized": null },
    { "note": "texto é normalizado", "field": { "type": "short_text", "required": true }, "value": "  Maria   Souza ", "valid": true, "normalized": "Maria Souza" },
    { "note": "texto não aceita número", "field": { "type": "short_text", "required": true }, "value": 123, "valid": false },
    { "note": "texto longo mantém quebras", "field": { "type": "long_text", "required": true }, "value": "linha 1\r\n\r\n\r\nlinha 2", "valid": true, "normalized": "linha 1\n\nlinha 2" },
    { "note": "email válido", "field": { "type": "email", "required": true }, "value": "maria@example.com", "valid": true, "normalized": "maria@example.com" },
    { "note": "email com espaços nas pontas", "field": { "type": "email", "required": true }, "value": "  maria@example.com ", "valid": true, "normalized": "maria@example.com" },
    { "note": "email sem domínio", "field": { "type": "email", "required": true }, "value": "maria@", "valid": false },
    { "note": "email sem arroba", "field": { "type": "email", "required": true }, "value": "maria.example.com", "valid": false },
    { "note": "número inteiro em texto", "field": { "type": "number", "required": true }, "value": "42", "valid": true, "normalized": "42" },
    { "note": "número JSON", "field": { "type": "number", "required": true }, "value": 12, "valid": true, "normalized": "12" },
    { "note": "decimal com vírgula", "field": { "type": "number", "required": true }, "value": "3,5", "valid": true, "normalized": "3.5" },
    { "note": "negativo com decimais", "field": { "type": "number", "required": true }, "value": "-10.25", "valid": true, "normalized": "-10.25" },
    { "note": "notação científica não é aceita", "field": { "type": "number", "required": true }, "value": "1e5", "valid": false },
    { "note": "mais de 6 casas decimais", "field": { "type": "number", "required": true }, "value": "1.1234567", "valid": false },
    { "note": "texto em campo numérico", "field": { "type": "number", "required": true }, "value": "abc", "valid": false },
    { "note": "data ISO", "field": { "type": "date", "required": true }, "value": "2026-10-23", "valid": true, "normalized": "2026-10-23" },
    { "note": "data no formato brasileiro não é aceita (o front envia ISO)", "field": { "type": "date", "required": true }, "value": "23/10/2026", "valid": false },
    { "note": "data inexistente", "field": { "type": "date", "required": true }, "value": "2026-02-30", "valid": false },
    { "note": "escolha única válida", "field": { "type": "single_choice", "required": true, "options": ["a", "b"] }, "value": "a", "valid": true, "normalized": "a" },
    { "note": "escolha única fora das opções", "field": { "type": "single_choice", "required": true, "options": ["a", "b"] }, "value": "c", "valid": false },
    { "note": "escolha única não aceita lista", "field": { "type": "single_choice", "required": true, "options": ["a", "b"] }, "value": ["a"], "valid": false },
    { "note": "múltipla escolha válida, ordem preservada", "field": { "type": "multiple_choice", "required": true, "options": ["a", "b", "c"] }, "value": ["c", "a"], "valid": true, "normalized": ["c", "a"] },
    { "note": "múltipla escolha repetida", "field": { "type": "multiple_choice", "required": true, "options": ["a", "b"] }, "value": ["a", "a"], "valid": false },
    { "note": "múltipla escolha fora das opções", "field": { "type": "multiple_choice", "required": true, "options": ["a", "b"] }, "value": ["c"], "valid": false },
    { "note": "múltipla escolha não aceita texto", "field": { "type": "multiple_choice", "required": true, "options": ["a", "b"] }, "value": "a", "valid": false },
    { "note": "múltipla escolha obrigatória vazia", "field": { "type": "multiple_choice", "required": true, "options": ["a", "b"] }, "value": [], "valid": false },
    { "note": "múltipla escolha opcional vazia", "field": { "type": "multiple_choice", "required": false, "options": ["a", "b"] }, "value": [], "valid": true, "normalized": null }
  ]
}
